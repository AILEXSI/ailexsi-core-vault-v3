# AILEXSI Core Vault V2 — environment template
# Copy to .env for local development. Never commit secrets.

# Canonical Core EventStore database (separate from any production Core DB)
# Local docker-compose default (see docker-compose.yml):
CORE_DATABASE_URL=postgres://ailexsi_v2:ailexsi_v2_dev@127.0.0.1:5433/ailexsi_v2_core

# Optional V2 derived read-model / search index DB (NON-CANONICAL, REBUILDABLE)
V2_DATABASE_URL=postgres://ailexsi_v2_derived:change-me@127.0.0.1:5434/ailexsi_v2_derived

# Harbor derived index (NON-CANONICAL, REBUILDABLE). Survives process restart.
# Never EventStore. Never Core. Safe to delete; rebuild from canonical.
# Desktop host defaults to data/derived-index when unset.
HARBOR_DERIVED_INDEX_PATH=data/derived-index

# Path to ailexsi-core checkout pinned at config/baselines.json core.sha
# Default: .deps/ailexsi-core (created by scripts/setup-core-deps.mjs)
CORE_CHECKOUT_PATH=.deps/ailexsi-core

# Optional path to current vault checkout for migration *scan* fixtures only
VAULT_REFERENCE_PATH=.deps/ailexsi-core-vault

# Ollama (Cultivation) — optional; tests mock the provider
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Runtime environment tag for EventEnvelope.environment
AILEXSI_ENV=development

# Channel Token for the Desktop HTTP bridge (127.0.0.1 only). Not an actor.
DESKTOP_HOST_TOKEN=change-me
VITE_DESKTOP_HOST_TOKEN=change-me
